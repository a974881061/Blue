#!name=大悦城签到
#!desc=微信小程序「大悦城商场JOYCITY」每日自动签到，基于 mallcoo 猫酷商场系统，Token 自动抓取
#!author=辣堡
#!homepage=https://github.com/a974881061/Blue
#!icon=https://raw.githubusercontent.com/a974881061/Blue/refs/heads/main/icons/joycity.png

[Script]
# Token 自动抓取（打开小程序签到页触发）
http-request ^https:\/\/m\.mallcoo\.cn\/api\/user\/User\/GetCheckinDetail script-path=https://raw.githubusercontent.com/a974881061/Blue/refs/heads/main/Scripts/mallcoo_gettoken.js, tag=大悦城Token抓取, requires-body=true, timeout=10, enabled=true

# 每日签到（cron 定时，默认每天 09:00）
cron "0 9 * * *" script-path=https://raw.githubusercontent.com/a974881061/Blue/refs/heads/main/Scripts/mallcoo_signin.js, tag=大悦城签到, enabled=true, timeout=60

[MITM]
hostname = m.mallcoo.cn
