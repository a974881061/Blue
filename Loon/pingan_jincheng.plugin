#!name=平安金橙福利社
#!desc=平安银行金橙福利社每日浏览任务自动完成，每个任务20积分，Cookie自动抓取
#!author=辣堡
#!homepage=https://github.com/a974881061/Blue
#!icon=https://raw.githubusercontent.com/a974881061/Blue/refs/heads/main/icons/pingan.png

[Script]
# Cookie 自动抓取（打开金橙福利社页面触发）
http-request ^https:\/\/rsb\.pingan\.com\.cn\/idata\/cust\/cmss_biz\/cmss\/task\/channel\/queryChannelTasksV4 script-path=https://raw.githubusercontent.com/a974881061/Blue/refs/heads/main/Scripts/pingan_jincheng_gettoken.js, tag=平安金橙Cookie抓取, requires-body=false, timeout=10, enabled=true

# 每日浏览任务（cron 定时，默认每天 09:00）
cron "0 9 * * *" script-path=https://raw.githubusercontent.com/a974881061/Blue/refs/heads/main/Scripts/pingan_jincheng_signin.js, tag=平安金橙福利社, enabled=true, timeout=180

[MITM]
hostname = rsb.pingan.com.cn, rsb2.pingan.com.cn
