#!name=DT生活签到
#!desc=DT生活微信小程序每日自动签到，每次+10积分。Token抓取无感化：仅拦截启动必调的getUserInfo、不读请求体、相同静默、30分钟内最多通知一次，不影响小程序正常使用。
#!author=辣堡
#!homepage=https://github.com/a974881061/Blue
#!icon=https://raw.githubusercontent.com/a974881061/Blue/refs/heads/main/icons/lb.jpg

[Script]
# Token 无感抓取：仅匹配 getUserInfo（启动必调、带 Bearer 头），不缓冲请求体，毫秒级放行
http-request ^https:\/\/ebeikeapi\.ebeck\.cn\/api\/v2\/user\/getUserInfo$ script-path=https://raw.githubusercontent.com/a974881061/Blue/refs/heads/main/Scripts/dt_gettoken.js, tag=DT生活Token抓取, requires-body=false, timeout=10, enabled=true

# 每日签到（每天 09:30）
cron "30 9 * * *" script-path=https://raw.githubusercontent.com/a974881061/Blue/refs/heads/main/Scripts/dt_signin.js, tag=DT生活签到, enabled=true, timeout=60

# 【临时】接口探测器：发现商品/价格接口用，浏览一遍小程序首页、商城、商品列表、商品详情后即可禁用本行
http-response ^https?:\/\/[^/]*ebeck\.cn\/ script-path=https://raw.githubusercontent.com/a974881061/Blue/refs/heads/main/Scripts/dt_api_explorer.js, tag=DT接口探测, requires-body=true, timeout=15, enabled=true

# 强制直连：保证签到请求与小程序登录同一网络出口，避免 IP 校验导致登录失败
[Rule]
DOMAIN,ebeikeapi.ebeck.cn,DIRECT

[MITM]
hostname = ebeikeapi.ebeck.cn, *.ebeck.cn
