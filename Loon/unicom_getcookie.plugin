#!name=中国联通Cookie抓取
#!desc=中国联通APP Cookie自动抓取，配合其他签到脚本使用。打开APP首页的流量查询即可获取。
#!author=dompling / 辣堡整理
#!homepage=https://github.com/a974881061/Blue
#!icon=https://raw.githubusercontent.com/Orz-3/mini/master/Color/10010.png

[Script]
# Cookie 自动抓取（打开联通APP流量查询页触发）
http-request https:\/\/m(?:xx)?\.client\.10010\.com\/(?:.*\/)?smartwisdomCommon(?:New)?(?:\?.*)?$ script-path=https://raw.githubusercontent.com/a974881061/Blue/refs/heads/main/Scripts/unicom_getcookie.js, tag=联通Cookie抓取, requires-body=true, timeout=15, enabled=true

[MITM]
hostname = m.client.10010.com, mxx.client.10010.com
